<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body        { font-family: Helvetica, Arial, sans-serif; color: #111827; font-size: 14px; margin: 0; padding: 0; background: #f3f4f6; }
      .wrapper    { max-width: 600px; margin: 32px auto; background: #ffffff; border-radius: 8px; overflow: hidden; }
      .body       { padding: 28px 32px; }
      .body p     { margin: 0 0 16px; line-height: 1.6; color: #374151; }
      .button     { display: inline-block; padding: 10px 20px; background: <%= @business.primary_color.presence || '#4338ca' %>; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-weight: 600; }
      .footer     { padding: 16px 32px; background: #f9fafb; border-top: 1px solid #e5e7eb; font-size: 12px; color: #6b7280; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="body">
        <p>Hi <%= @user.name %>,</p>
        <p>A password reset was requested for your <%= @app_name %> account.</p>
        <p><a href="<%= @reset_url %>" class="button">Reset password</a></p>
        <p>Or copy this link into your browser:<br/><%= @reset_url %></p>
      </div>
      <div class="footer">
        If you weren't expecting this, you can safely ignore this email — your password won't change.
      </div>
    </div>
  </body>
</html>
